generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ShortUrl {
  id            String   @id @default(cuid())
  code          String   @unique
  originalUrl   String
  clickCount    Int      @default(0)
  lastVisitedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
